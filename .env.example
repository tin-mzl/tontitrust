# TontiTrust - Environment Configuration Example
# Copy this file to .env for local overrides

ENVIRONMENT=development
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payment Providers (Sandbox / Simulator)
PAYMENT_PROVIDER=SIMULATOR
PAYMENT_WEBHOOK_SECRET=whsec_demo_secret_key_tontitrust_2026

# SMS / OTP Provider (Twilio or Local Aggregator)
SMS_PROVIDER=SIMULATOR
TWILIO_ACCOUNT_SID=AC_mock_account_sid
TWILIO_AUTH_TOKEN=mock_auth_token
TWILIO_FROM_NUMBER=+243900000000

# Security & Limits
JWT_SECRET=super_secret_jwt_signing_key_mvp_2026
MAX_MEMBERS_PER_TONTINE=50
MIN_MEMBERS_PER_TONTINE=2
MAX_OTP_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10
