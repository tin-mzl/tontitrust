rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(uid())); }
    function isAdmin() { return isAuthenticated() && userDoc().data.role == 'admin'; }
    function isValidated() { return isAuthenticated() && userDoc().data.kycStatus == 'validated' && userDoc().data.suspended != true; }

    match /users/{userId} {
      allow read: if isAuthenticated() && (uid() == userId || isAdmin());
      allow create: if isAuthenticated() && uid() == userId;
      allow update: if isAuthenticated() && (
        (uid() == userId && request.resource.data.role == resource.data.role && request.resource.data.suspended == resource.data.suspended) ||
        isAdmin()
      );
      allow delete: if false;
    }

    match /kycReviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    match /tontines/{tontineId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == uid() || uid() in resource.data.memberIds || isAdmin()
      );
      allow create: if isValidated() && request.resource.data.createdBy == uid();
      allow update: if isAuthenticated() && (
        resource.data.createdBy == uid() || isAdmin()
      );
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isAuthenticated() && (
          uid() in get(/databases/$(database)/documents/tontines/$(tontineId)).data.memberIds || isAdmin()
        );
        allow create: if isValidated() && request.resource.data.memberId == uid();
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/tontines/$(tontineId)).data.createdBy == uid() || isAdmin()
        );
        allow delete: if false;
      }
    }

    match /logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == uid();
      allow update: if isAuthenticated() && resource.data.userId == uid();
      allow create, delete: if false;
    }
  }
}
